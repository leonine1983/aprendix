# 🕒 Timezone (usado indiretamente)
TIME_ZONE=America/Sao_Paulo

# 🔐 Segurança dos cookies em produção (HTTPS)
# Garante que o cookie de sessão só seja transmitido via HTTPS
SESSION_COOKIE_SECURE=true

# Impede o acesso aos cookies via JavaScript (protege contra XSS)
SESSION_COOKIE_HTTPONLY=true

# Define a política de envio de cookies entre sites
SESSION_COOKIE_SAMESITE=Strict

# Garante que o cookie CSRF só seja enviado via HTTPS
CSRF_COOKIE_SECURE=true


# 📦 Banco de Dados PostgreSQL
DB_SQLITE=true
DB_NAME=aprendix
DB_USER=seu_usuario
DB_PASSWORD=sua_senha_segura
DB_HOST=localhost
DB_PORT=5432

