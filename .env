# 📧 Email
EMAIL_HOST=smtp.seudominio.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=usuario@seudominio.com
EMAIL_HOST_PASSWORD=sua_senha_de_email
